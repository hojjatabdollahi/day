<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.hojjatabdollahi.day</id>
  <name>Day</name>
  <summary>Clock, calendar, world clocks, stopwatch and timer for COSMIC</summary>
  <launchable type="desktop-id">io.github.hojjatabdollahi.day.desktop</launchable>
  <developer id="io.github.hojjatabdollahi">
    <name>Hojjat</name>
  </developer>
  <description>
    <p>Clock applet for the COSMIC panel. With timer, stopwatch, world clock, and optional Persian (Shamsi) calendar.</p>
    <ul>
      <li>Clock in the panel with optional date, weekday and seconds, in 12 or 24-hour time</li>
      <li>Month calendar with a configurable first day of the week and a jump back to today</li>
      <li>Persian (Shamsi) calendar overlay</li>
      <li>World clocks with offline city search, a day/night indicator and the offset from local time</li>
      <li>Stopwatch with laps</li>
      <li>Countdown timer with Pomodoro presets and a notification when it finishes</li>
      <li>Follows system timezone changes and refreshes on wake from sleep</li>
    </ul>
  </description>
